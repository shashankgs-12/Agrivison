rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isAuthenticated() {
      return request.auth != null;
    }

    function ownsUser(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function ownsFarm(farmId) {
      return isAuthenticated()
        && firestore.get(/databases/(default)/documents/farms/$(farmId)).data.ownerId == request.auth.uid;
    }

    function isImageUpload() {
      return request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
    }

    match /users/{userId}/{allPaths=**} {
      allow read: if ownsUser(userId);
      allow write: if ownsUser(userId) && isImageUpload();
    }

    match /farms/{farmId}/{allPaths=**} {
      allow read: if ownsFarm(farmId);
      allow write: if ownsFarm(farmId) && isImageUpload();
    }

    match /scans/{userId}/{allPaths=**} {
      allow read: if ownsUser(userId);
      allow write: if ownsUser(userId) && isImageUpload();
    }
  }
}
