# Firebase Configuration
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id

# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key

# Google Maps API
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# Weather API
WEATHER_API_KEY=your_weather_api_key

# Authentication and database
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public
AUTH_SECRET=generate_a_unique_32_byte_secret

# Google OAuth (create a Web application client in Google Cloud Console)
# Add each local callback URL you use to Authorized redirect URIs:
# http://localhost:3000/api/auth/callback/google
# http://localhost:3001/api/auth/callback/google
# Register your exact production callback URL as well.
AUTH_GOOGLE_ID=your_google_oauth_web_client_id.apps.googleusercontent.com
AUTH_GOOGLE_SECRET=your_google_oauth_web_client_secret

# Firebase Phone OTP
# Enable Phone sign-in in Firebase Authentication and authorize your app domain.
# Firebase web phone auth needs an authorized hosted domain (localhost is not supported).
# Use the Firebase Auth Emulator/test phone numbers locally, or an authorized HTTPS domain.
# Never disable app verification in production.
