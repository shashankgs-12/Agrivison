rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    function owns(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['ADMIN', 'admin'];
    }

    function ownsFarm(farmId) {
      return isAuthenticated()
        && exists(/databases/$(database)/documents/farms/$(farmId))
        && get(/databases/$(database)/documents/farms/$(farmId)).data.ownerId == request.auth.uid;
    }

    match /users/{userId} {
      allow read: if owns(userId) || isAdmin();
      allow create: if owns(userId)
        && request.resource.data.uid == userId
        && (!('role' in request.resource.data) || request.resource.data.role in ['FARMER', 'farmer'])
        && (!('subscription' in request.resource.data) || request.resource.data.subscription in ['FREE', 'free']);
      allow update: if isAdmin() || (
        owns(userId)
        && request.resource.data.role == resource.data.role
        && request.resource.data.subscription == resource.data.subscription
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['name', 'phone', 'location', 'image', 'languagePreferences', 'updatedAt'])
      );
      allow delete: if isAdmin();
    }

    match /farms/{farmId} {
      allow read: if isAdmin() || owns(resource.data.ownerId);
      allow create: if isAuthenticated() && request.resource.data.ownerId == request.auth.uid;
      allow update: if isAdmin() || (
        owns(resource.data.ownerId)
        && request.resource.data.ownerId == resource.data.ownerId
      );
      allow delete: if isAdmin() || owns(resource.data.ownerId);

      match /fields/{fieldId} {
        allow read, create, update, delete: if isAdmin() || ownsFarm(farmId);
      }
    }

    match /crops/{cropId} {
      allow read: if isAdmin() || owns(resource.data.ownerId);
      allow create: if isAuthenticated()
        && request.resource.data.ownerId == request.auth.uid
        && ownsFarm(request.resource.data.farmId);
      allow update: if isAdmin() || (
        owns(resource.data.ownerId)
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.farmId == resource.data.farmId
      );
      allow delete: if isAdmin() || owns(resource.data.ownerId);
    }

    match /diseaseDetections/{detectionId} {
      allow read: if isAdmin() || owns(resource.data.userId);
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin() || owns(resource.data.userId);
    }

    match /plantIdentifications/{identificationId} {
      allow read: if isAdmin() || owns(resource.data.userId);
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin() || owns(resource.data.userId);
    }

    match /notifications/{notificationId} {
      allow read, update: if isAdmin() || owns(resource.data.userId);
      allow create: if isAdmin() || (
        isAuthenticated() && request.resource.data.userId == request.auth.uid
      );
      allow delete: if isAdmin() || owns(resource.data.userId);
    }
  }
}
