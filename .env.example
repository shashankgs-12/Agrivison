# Copy to .env.local for development. Set production values in your hosting provider.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public
AUTH_SECRET=generate_a_unique_32_byte_secret
AUTH_URL=http://localhost:3000

# Optional Google OAuth
AUTH_GOOGLE_ID=your_google_oauth_web_client_id.apps.googleusercontent.com
AUTH_GOOGLE_SECRET=your_google_oauth_web_client_secret

# Password reset email delivery (Resend)
# Omit locally to print a test reset URL in the Next.js server console.
RESEND_API_KEY=
RESEND_FROM_EMAIL="AgriVision.AI <no-reply@your-verified-domain.example>"

# Gemini AI
GEMINI_API_KEY=your_gemini_api_key

# Public contact shown on the Contact page
NEXT_PUBLIC_SUPPORT_EMAIL=support@your-domain.example
