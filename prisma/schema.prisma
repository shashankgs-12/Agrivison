generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  FARMER
  ADMIN
}

enum SubscriptionTier {
  FREE
  PREMIUM
}

model User {
  id            String           @id @default(cuid())
  name          String?
  email         String?          @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  phone         String?
  location      String?
  role          UserRole         @default(FARMER)
  subscription  SubscriptionTier @default(FREE)
  isActive      Boolean          @default(true)
  accounts      Account[]
  sessions      Session[]
  farms         Farm[]
  plantScans    PlantScan[]
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Farm {
  id              Int      @id @default(autoincrement())
  ownerId         String?
  name            String
  location        String
  latitude        Float?
  longitude       Float?
  boundary        Json?
  area            Float
  areaHectares    Float?
  perimeterMeters Float?
  soilType        String?
  waterSource     String?
  surveyMethod    String?
  requestKey      String?  @unique
  status          String   @default("Healthy")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  owner           User?    @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  crops           Crop[]
}

model Crop {
  id                       String   @id @default(cuid())
  farmId                   Int
  name                     String
  variety                  String?
  sowingDate               String
  expectedHarvest          String?
  lifecycleType            String   @default("ANNUAL")
  establishmentPeriodMonths Int?
  maturityPeriodMonths     Int?
  firstExpectedHarvest     String?
  harvestIntervalMonths    Int?
  maintenanceSchedule     Json?
  growthStage              String
  area                     Float
  waterNeed                String
  health                   String?
  diseaseStatus            String?
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
  farm                     Farm     @relation(fields: [farmId], references: [id], onDelete: Cascade)

  @@index([farmId])
}

model PlantScan {
  id                    String   @id @default(cuid())
  userId                String?
  imageUrl              String   @db.Text
  plantName             String
  scientificName        String?
  confidence            Float
  description           String?  @db.Text
  visibleCharacteristics String? @db.Text
  recommendedCare       String?  @db.Text
  commonDiseases        String?  @db.Text
  suitableSoil          String?
  waterRequirement      String?
  sunlightRequirement   String?
  language              String   @default("en")
  rawResult             String?  @db.Text
  createdAt             DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)
}
